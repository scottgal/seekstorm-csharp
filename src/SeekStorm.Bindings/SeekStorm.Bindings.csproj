<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- NativeAOT -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- NuGet packaging -->
    <PackageId>SeekStorm.Bindings</PackageId>
    <Version>0.1.0</Version>
    <Authors>SeekStorm Contributors</Authors>
    <Description>High-performance, AOT-compatible C# FFI bindings for the SeekStorm search library</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>search;full-text;seekstorm;ffi;nativeaot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/scottgal/seekstorm-csharp</PackageProjectUrl>

    <!-- JSON source generator -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!-- Platform-specific native binaries packed alongside the managed assembly -->
  <!-- Uses glob pattern; only existing directories are included -->
  <ItemGroup>
    <None Include="../../runtimes/**/native/*"
          Pack="true" PackagePath="runtimes/%(RecursiveDir)/%(Filename)%(Extension)" />
    <None Include="../../README.md"
          Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
