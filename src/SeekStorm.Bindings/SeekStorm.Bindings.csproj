<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- NativeAOT -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- NuGet packaging -->
    <PackageId>SeekStorm.Bindings</PackageId>
    <Version>0.1.0</Version>
    <Authors>SeekStorm Contributors</Authors>
    <Description>High-performance, AOT-compatible C# FFI bindings for the SeekStorm search library</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>search;full-text;seekstorm;ffi;nativeaot</PackageTags>

    <!-- JSON source generator -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!-- Platform-specific native binaries packed alongside the managed assembly -->
  <ItemGroup>
    <None Include="../../runtimes/win-x64/native/seekstorm_ffi.dll"
          Pack="true" PackagePath="runtimes/win-x64/native/seekstorm_ffi.dll" />
    <None Include="../../runtimes/linux-x64/native/libseekstorm_ffi.so"
          Pack="true" PackagePath="runtimes/linux-x64/native/libseekstorm_ffi.so" />
    <None Include="../../runtimes/linux-arm64/native/libseekstorm_ffi.so"
          Pack="true" PackagePath="runtimes/linux-arm64/native/libseekstorm_ffi.so" />
    <None Include="../../runtimes/osx-x64/native/libseekstorm_ffi.dylib"
          Pack="true" PackagePath="runtimes/osx-x64/native/libseekstorm_ffi.dylib" />
    <None Include="../../runtimes/osx-arm64/native/libseekstorm_ffi.dylib"
          Pack="true" PackagePath="runtimes/osx-arm64/native/libseekstorm_ffi.dylib" />
  </ItemGroup>

</Project>
