<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SeekStorm.Bindings/SeekStorm.Bindings.csproj" />
  </ItemGroup>

  <!-- Copy native binary to output for local runs -->
  <Target Name="CopyNativeBinary" AfterTargets="Build">
    <Copy SourceFiles="$(ProjectDir)../../runtimes/osx-arm64/native/libseekstorm_ffi.dylib"
          DestinationFolder="$(OutputPath)"
          Condition="Exists('$(ProjectDir)../../runtimes/osx-arm64/native/libseekstorm_ffi.dylib')" />
  </Target>

</Project>
